# Copy to .env and replace every CHANGE_ME value. .env is gitignored.
# These are LOCAL DEVELOPMENT credentials for a synthetic demo environment.
# Generate values with:  python -c "import secrets; print(secrets.token_urlsafe(18))"

# PostgreSQL server (one server, separate logical databases and roles)
DATAOPS_PG_HOST=127.0.0.1
DATAOPS_PG_PORT=5432

# Superuser, used ONLY by the bootstrap step that creates databases and roles
DATAOPS_PG_ADMIN_USER=postgres
DATAOPS_PG_ADMIN_PASSWORD=CHANGE_ME

# Operational source database (owns transactions)
DATAOPS_SOURCE_DB=commerce_source
DATAOPS_SRC_APP_PASSWORD=CHANGE_ME        # role src_app: generator / simulated application writes
DATAOPS_SRC_READER_PASSWORD=CHANGE_ME     # role src_reader: read-only batch extraction

DATAOPS_CDC_PASSWORD=CHANGE_ME           # role cdc_reader: Debezium logical replication (full profile)

# Analytical warehouse
DATAOPS_WAREHOUSE_DB=warehouse
DATAOPS_WH_LOADER_PASSWORD=CHANGE_ME      # role wh_loader: writes raw schema only
DATAOPS_WH_TRANSFORM_PASSWORD=CHANGE_ME   # role wh_transform: dbt; reads raw, owns analytics schemas
DATAOPS_WH_READER_PASSWORD=CHANGE_ME      # role wh_reader: read-only consumers (API, reconciliation)

# Reliability and AI metadata
DATAOPS_RELIABILITY_DB=reliability
DATAOPS_REL_APP_PASSWORD=CHANGE_ME        # role rel_app: collectors, incident engine, recovery audit
DATAOPS_REL_READER_PASSWORD=CHANGE_ME     # role rel_reader: read-only (AI investigator tools)

# Airflow metadata (full profile only)
DATAOPS_AIRFLOW_DB=airflow
DATAOPS_AIRFLOW_DB_PASSWORD=CHANGE_ME
