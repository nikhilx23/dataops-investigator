      "datasource": {
        "type": "prometheus",
        "uid": "dataops-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dataops_freshness_lag_seconds",
