          "datasource": {
            "type": "prometheus",
            "uid": "dataops-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 13,
      "title": "Investigations by mode and status",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "dataops-prom"
      },
      "gridPos": {
        "x": 18,
        "y": 20,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dataops_investigations_total",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "dataops-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "renameByName": {
              "Value": "count"
            }
          }
        }
      ]
    }
