{
  "uid": "dataops-overview",
  "title": "DataOps Investigator \u2014 reliability",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "dataops"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Active sev1 incidents",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "dataops-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dataops_active_incidents{severity=\"sev1\"}",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "dataops-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Active incidents (all)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "dataops-prom"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(dataops_active_incidents)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "dataops-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
