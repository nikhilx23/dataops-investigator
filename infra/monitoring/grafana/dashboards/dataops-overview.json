      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 11,
      "title": "Recovery actions by status",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "dataops-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dataops_recovery_actions_total",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "dataops-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "renameByName": {
              "Value": "count"
            }
          }
        }
      ]
    },
    {
      "id": 12,
      "title": "Detection \u2192 verified recovery",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "dataops-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dataops_incident_seconds_to_verified",
